<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.autonavi.minimap" />
    </queries>

    <!-- 允许应用显示在其他应用上层 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 获取大致位置和精确位置 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 13及以上通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务及位置类型前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 允许访问网络，用于百度地图POI地点检索 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 允许读取网络状态，用于判断百度地图数据请求环境 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".app.NearbyCheckInApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NearbyCheckIn"
        android:usesCleartextTraffic="true"
        >

        <!-- 百度地图开放平台Android应用访问密钥 -->
        <meta-data
            android:name="com.baidu.lbsapi.API_KEY"
            android:value="${BAIDU_MAP_AK}" />

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.NearbyCheckIn"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".platform.multiwindow.DualMapLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 巡航定位和系统悬浮窗前台服务 -->
        <service
            android:name=".platform.cruise.CruiseService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 双地图分屏诊断和用户请求触发的节点打卡无障碍服务 -->
        <service
            android:name=".platform.accessibility.DualMapAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/dual_map_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
